# Local development: SQLite + dev login, no Docker or GCP needed (`make run` copies this to .env).
# On Cloud Run the values are set by Terraform (gcp repo: modules/app-environment/services.tf).
APP_ENV=local
LOG_LEVEL=INFO
GCP_PROJECT_ID=pizza-local

DATABASE_URL=sqlite+pysqlite:///./pizza.db
# PostgreSQL like on Cloud SQL instead: `docker compose up -d db` and
# DATABASE_URL=postgresql+psycopg://pizza:pizza@localhost:5432/pizza
# On Cloud Run DATABASE_URL is not set, the Cloud SQL socket is used:
# DB_INSTANCE_CONNECTION_NAME=pizza-dev-4821:europe-central2:pizza-dev-pg
# DB_NAME=pizza
# DB_USER=pizza_app
# DB_PASSWORD=<Secret Manager: db-password>

# Login without Identity Platform: the frontend (VITE_AUTH_MODE=dev) sends dev:<user>:<role> tokens.
# Refused unless APP_ENV=local.
DEV_AUTH_ENABLED=true
# Identity Platform tokens (used when DEV_AUTH_ENABLED is off), e.g. against the dev project:
AUTH_ISSUER=https://securetoken.google.com/pizza-dev-4821
AUTH_AUDIENCE=pizza-dev-4821

ORDERS_TOPIC=order-events
USE_INMEMORY_EVENTS=true

# Vite dev server of the frontend repo
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PROMO_CODES_ENABLED=true
